!/.gitattributes
!/.editorconfig
!/.clang-format
!/README.md
!/CMakeLists.txt
!/build.ps1
!/src/
!/src/**
!/include/
!/include/**
!/tests/
!/tests/**
!/scripts/
!/scripts/**
/scripts/cleanup-recomp-cache.py

!/experiments/
/experiments/*
!/experiments/ra2-recomp-20261020/
/experiments/ra2-recomp-20261020/*
